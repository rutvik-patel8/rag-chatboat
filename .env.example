# Copy to .env and fill in GEMINI_API_KEY. Read by both ingest/ (Python) and web/ (Next.js).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match vector(768) in db/schema.sql
EMBED_DIM=768
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
# Optional: embedding texts per minute (Gemini free tier = 100; raise on a paid plan)
# EMBED_REQUESTS_PER_MINUTE=100
# EMBED_TOKENS_PER_MINUTE=20000
# Optional: generation calls per minute for section summaries (raise on a paid plan)
# GEMINI_CHAT_REQUESTS_PER_MINUTE=10
# Optional: model for ingest-time section summaries (defaults to GEMINI_CHAT_MODEL)
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# Optional: model for transcribing iMac pages with vision (defaults to GEMINI_SUMMARY_MODEL)
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
